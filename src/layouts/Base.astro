---
/* Every hub page: head, background glow, top bar (title | theme pill | tabs), status line, footer.
   Standalone simulations in public/ have their own copy of this chrome. */
import '../styles/global.css';
import ThemePicker from '../components/ui/ThemePicker.svelte';
import PerfPicker from '../components/ui/PerfPicker.svelte';
import CommandPalette from '../components/ui/CommandPalette.svelte';
import DataBooklet from '../components/ui/DataBooklet.svelte';
import { SUBJECTS, type SubjectId } from '../data/subjects';

export interface Stat { label: string; value: string | number }
interface Props {
  title?: string;           // page title; the site name is appended
  description: string;
  tab?: 'home' | 'papers' | SubjectId;
  status: { label: string; hint: string };
  stats?: Stat[];
}
const { title, description, tab, status, stats = [] } = Astro.props;
const fullTitle = title ? `${title} · Edexcel IAL Arsenal` : 'Edexcel IAL Arsenal';
const tabs = [{ id: 'home', name: 'Home', short: 'Home', href: '/' }, ...SUBJECTS.map((s) => ({ id: s.id, name: s.name, short: s.short, href: `/${s.id}/` })),
  { id: 'papers', name: 'Past papers', short: 'Papers', href: '/papers/' }];
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL('/brand/ial-arsenal-logo-colorful.png', Astro.site)} />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/brand/ial-arsenal-logo-colorful.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#1e66f5" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" /></noscript>
  <script is:inline>
    /* Before first paint: restore the saved palette + mode so the page never flashes the default theme.
       Same keys as src/scripts/theme.ts and the simulations. */
    (function () {
      var r = document.documentElement, g = function (k, d) { try { var v = localStorage.getItem('arsenal-' + k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } };
      var m = g('mode', 'auto'); if (m !== 'light' && m !== 'dark') m = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      r.setAttribute('data-palette', g('palette', 'catppuccin')); r.setAttribute('data-mode', m);
      var pf = g('perf', null);
      if (pf && typeof pf === 'object') {
        if (pf.glass === false) r.setAttribute('data-glass', 'off');
        if (pf.aurora === false) r.setAttribute('data-aurora', 'off');
        if (pf.reducedMotion === true) r.setAttribute('data-motion', 'reduced');
        if (pf.textScale === 'compact' || pf.textScale === 'large') r.setAttribute('data-text', pf.textScale);
      } else {
        var n = navigator, low = (n.connection && n.connection.saveData) || (n.deviceMemory && n.deviceMemory <= 4) || (n.hardwareConcurrency && n.hardwareConcurrency <= 4);
        if (low) { r.setAttribute('data-glass', 'off'); r.setAttribute('data-aurora', 'off'); }
      }
      /* the big rise-in plays on the first page of a visit only */
      try { if (!(pf && pf.reducedMotion) && !sessionStorage.getItem('arsenal-booted')) { r.classList.add('booting'); sessionStorage.setItem('arsenal-booted', '1'); setTimeout(function () { r.classList.remove('booting'); }, 1600); } } catch (e) {}
    })();
  </script>
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="wrap">
    <header class="top">
      <div class="brand">
        <p class="eyebrow">Edexcel International A Level · Sciences</p>
        <h1><a href="/"><img class="logo" src="/brand/ial-arsenal-logo-colorful.svg" width="44" height="44" alt="" /><span><span class="d">E</span>dexcel IAL Arsenal</span></a></h1>
      </div>
      <div class="top-tools">
        <CommandPalette client:load />
        <DataBooklet client:load />
        <ThemePicker client:load />
        <PerfPicker client:load />
      </div>
      <nav class="tabs" aria-label="Subjects">
        {tabs.map((t) => (
          <a href={t.href} aria-label={t.name} aria-current={tab === t.id ? 'page' : undefined}>
            {tab === t.id && <span class="ind" aria-hidden="true"></span>}
            <span class="lg">{t.name}</span><span class="sm">{t.short}</span>
          </a>
        ))}
      </nav>
    </header>
    <div class="statusbar">
      <p class="sb-l"><b>{status.label}</b> · {status.hint}</p>
      <div class="sb-r">
        {stats.map((s) => <span class="stat"><small>{s.label}</small><b>{s.value}</b></span>)}
      </div>
    </div>
    <main id="content">
      <slot />
    </main>
    <footer class="foot">
      <span>Edexcel IAL Arsenal · Made by <a class="maker" href="https://github.com/TheCodeHeist">Md Riyasat Hossain</a>. By students, for students. Open source, and not affiliated with Pearson Edexcel.</span>
      <nav aria-label="Site"><a href="/about/">About</a><a href="https://github.com/TheCodeHeist/edexcel-ial-arsenal">GitHub</a></nav>
    </footer>
  </div>
  <script>
    import { glint } from '../lib/motion';
    glint('.card,.subject,.panel');
    if ('serviceWorker' in navigator) addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
  </script>
</body>
</html>
