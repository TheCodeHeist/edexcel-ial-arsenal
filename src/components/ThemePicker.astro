---
/* The glass theme pill and its popover. The markup is rendered here; src/scripts/theme.ts wires it and paints the
   current palette into it. */
import { PALETTES } from '../data/palettes';
const sw = (c: { bg: string; accent: string; redox: string; ligand: string; acidbase: string; amph: string }) =>
  ({ style: `--pb:${c.bg};background:${c.bg}`, dots: [c.accent, c.redox, c.ligand, c.acidbase, c.amph] });
---
<div class="theme-wrap" id="theme">
  <button class="theme-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Theme">
    <span class="dots"></span><span class="theme-name"></span>
  </button>
  <div class="theme-pop" hidden>
    <div class="tp-h"><b>Palette</b><b class="tp-note"></b></div>
    <div class="tp-list">
      {Object.entries(PALETTES).map(([k, P]) => (
        <button type="button" class="tp-row" data-p={k}>
          <span><span class="nm">{P.name}</span><span class="vn">{P.light.v} · {P.dark.v}</span></span>
          {[P.light, P.dark].map((c) => { const s = sw(c); return (
            <span class="tp-sw" style={s.style}>{s.dots.map((x) => <i style={`background:${x}`}></i>)}</span>
          ); })}
        </button>
      ))}
    </div>
    <div class="tp-mode">
      <div class="seg" role="group" aria-label="Light or dark">
        <button type="button" data-tm="auto">Auto</button><button type="button" data-tm="light">Light</button><button type="button" data-tm="dark">Dark</button>
      </div>
    </div>
  </div>
</div>
