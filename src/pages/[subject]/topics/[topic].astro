---
/* One spec statement: every published past-paper part tagged with it, newest series first. Each part is shown
   with what it needs to make sense on its own (its question's opening and its lead-in), then its mark scheme
   behind a toggle, and a link to the whole paper. */
import Base from '../../../layouts/Base.astro';
import '../../../styles/papers.css';
import { SUBJECTS } from '../../../data/subjects';
import type { Crop } from '../../../lib/papers/types';
import { cropUrl } from '../../../lib/papers/crops';
import { topicList, partsByTopic, seriesName, paperSlug, topicIndex, type TaggedPart } from '../../../lib/papers/registry';

export function getStaticPaths() {
  return SUBJECTS.flatMap((s) => {
    const list = topicList(s.id);
    const parts = partsByTopic(s.id);
    if (!list) return [];
    return list.units.flatMap((u) => u.groups.flatMap((g) => g.points.filter((p) => parts.has(p.id)).map((p) => ({
      params: { subject: s.id, topic: p.id },
      props: { subjectId: s.id, unit: u.code, unitTitle: u.title, group: `${g.id} ${g.title}`, point: p,
               items: parts.get(p.id)! },
    }))));
  });
}
const { subjectId, unit, unitTitle, group, point, items } = Astro.props as {
  subjectId: string; unit: string; unitTitle: string; group: string;
  point: { id: string; short: string; text: string; core?: number; skill?: true }; items: TaggedPart[];
};
const s = SUBJECTS.find((x) => x.id === subjectId)!;
const topics = topicIndex(s.id);
const marks = items.reduce((n, x) => n + x.part.marks, 0);
const papers = new Set(items.map((x) => x.paper.id)).size;

const size = (c: Crop) => ({ width: Math.round((c.w * 96) / 150), height: Math.round((c.h * 96) / 150) });
/* The lead-in a part needs: its question's opening (if the part isn't the whole question) and its own intro. */
const context = (x: TaggedPart) => [...x.question.stem, ...(x.part.intro ?? [])];
---
<Base
  title={`${point.short} · ${s.name} by topic`}
  description={`Every Edexcel IAL ${s.name} past-paper question on: ${point.text}`}
  tab={s.id}
  status={{ label: `${unit} · ${point.id}`, hint: point.short }}
  stats={[{ label: 'Parts', value: items.length }, { label: 'Marks', value: marks }, { label: 'Papers', value: papers }]}
>
  <nav class="paper-nav" aria-label="Topics">
    <a class="btn" href={`/${s.id}/topics/`}>All {s.name} topics</a>
  </nav>

  <header class="panel paper-head rise">
    <p class="eyebrow">{unit} · {unitTitle} · {group}</p>
    <h2>{point.short}</h2>
    <p class="credit">{point.text}</p>
    <p class="credit">{items.length} question part{items.length === 1 ? '' : 's'} from {papers} paper{papers === 1 ? '' : 's'},
      newest first. Topics were suggested by an AI reader and are being checked.</p>
  </header>

  <ol class="questions">
    {items.map((x) => (
      <li class="qcard panel">
        <div class="qhead">
          <h3><a href={`/${s.id}/papers/${paperSlug(x.paper)}/#q${x.question.number}`}>{x.paper.unit} {seriesName(x.paper, true)} · {x.part.label}</a></h3>
          <span class="marks">{x.part.marks} mark{x.part.marks === 1 ? '' : 's'}</span>
        </div>
        {context(x).map((c) => <img class="crop" src={cropUrl(c)} {...size(c)} loading="lazy" decoding="async" alt="" />)}
        {x.part.qp.map((c) => <img class="crop" src={cropUrl(c)} {...size(c)} loading="lazy" decoding="async" alt={`Question ${x.part.label}`} />)}
        {x.part.topics.length > 1 && (
          <div class="topics">
            {x.part.topics.filter((t) => t !== point.id).map((t) => topics.get(t)).filter(Boolean).map((t) =>
              <a class="chip" href={`/${s.id}/topics/${t!.id}/`} title={t!.text}>{t!.short}</a>)}
          </div>
        )}
        <details class="ms">
          <summary>Mark scheme</summary>
          <div class="ms-part">
            {x.part.kind === 'mcq' && x.part.answer && <p class="answer">Answer: <b>{x.part.answer}</b></p>}
            {x.part.ms.map((c) => <img class="crop" src={cropUrl(c)} {...size(c)} loading="lazy" decoding="async" alt={`Mark scheme for ${x.part.label}`} />)}
          </div>
        </details>
      </li>
    ))}
  </ol>
</Base>
